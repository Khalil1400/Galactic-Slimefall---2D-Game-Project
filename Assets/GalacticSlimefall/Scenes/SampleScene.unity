  - displayName: Nuke
    description: Heavy shell. Direct hits deal 30 damage and the shrapnel bursts
      for 5 each.
    projectilePrefab: {fileID: 55433713499545207, guid: 9c2c649c6ba5d214bb5720a0985bb43f, type: 3}
    ammo: 1
    accentColor: {r: 0.98, g: 0.52, b: 0.18, a: 1}
  - displayName: Cluster Bomb
    description: Splits in mid air into bomblets that each deal 10 damage on direct
      hit.
    projectilePrefab: {fileID: 3384031480832566017, guid: 6e3b11f7a7c24404a9847968c8b5a831, type: 3}
    ammo: 2
    accentColor: {r: 0.54, g: 0.91, b: 0.94, a: 1}
