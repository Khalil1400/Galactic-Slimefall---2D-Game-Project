#inventory-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: flex-start;
    padding-left: 24px;
    padding-bottom: 18px;
}

#inventory-shell {
    width: 620px;
    min-height: 140px;
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 12px;
    padding-left: 14px;
    background-color: rgba(8, 11, 18, 0.84);
    border-top-width: 2px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.04);
    border-left-color: rgba(255, 255, 255, 0.04);
}

#inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    min-height: 42px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

#inventory-copy {
    flex-grow: 1;
    margin-right: 16px;
}

#weapon-name {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

#weapon-description {
    color: rgba(213, 220, 229, 0.82);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

#ammo-chip {
    width: 82px;
    min-height: 38px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-width: 2px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.3);
    border-right-color: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.04);
    border-left-color: rgba(255, 255, 255, 0.04);
}

#ammo-value {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#inventory-slots {
    flex-direction: row;
    align-items: stretch;
}

.weapon-slot {
    width: 142px;
    height: 54px;
    margin-right: 8px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(23, 27, 36, 0.92);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 2px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.06);
}

.weapon-slot--selected {
    background-color: rgba(36, 44, 56, 0.96);
}

.weapon-slot--disabled {
    opacity: 0.68;
}

.weapon-slot__accent {
    width: 3px;
    height: 100%;
    background-color: rgba(120, 180, 255, 0.6);
}

.weapon-slot__content {
    flex-grow: 1;
    justify-content: center;
    padding-left: 8px;
    padding-right: 8px;
}

.weapon-slot__hotkey {
    color: rgba(255, 255, 255, 0.88);
    font-size: 10px;
    margin-bottom: 1px;
}

.weapon-slot__title {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.weapon-slot__detail {
    color: rgba(196, 205, 216, 0.82);
    font-size: 10px;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
}
